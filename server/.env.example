# Copy to server/.env and fill in the password you chose when installing PostgreSQL.
# The database named here ("setlog") is created automatically by `npm run migrate`.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/setlog

# Port the Express API listens on (the Vite dev server proxies /api to it).
PORT=4000

# Connection pool size.
PG_POOL_MAX=10
